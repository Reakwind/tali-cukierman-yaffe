#!/bin/sh
# Enforces short, conventional commit subject lines (<= 72 chars) for multi-agent clarity.
set -eu

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  echo "usage: .githooks/commit-msg <commit-msg-file>" >&2
  exit 2
fi

SUBJECT="$(sed -n '1p' "$MSG_FILE" | tr -d '\r')"

case "$SUBJECT" in
  Merge\ *|Revert\ *)
    exit 0
    ;;
esac

LEN="${#SUBJECT}"
if [ "$LEN" -eq 0 ]; then
  echo "REFUSED commit-msg: Empty commit subject. Fix: Use '<type>: <short imperative summary>' (<= 72 chars)." >&2
  exit 1
fi

if [ "$LEN" -gt 72 ]; then
  echo "REFUSED commit-msg: Subject line is $LEN chars (max 72). Fix: Shorten the first line to <= 72 chars." >&2
  exit 1
fi

if ! printf '%s\n' "$SUBJECT" | grep -Eq '^(feat|fix|docs|test|refactor|chore|build|ci|art)(\([a-z0-9._-]+\))?: .+'; then
  echo "REFUSED commit-msg: Subject '$SUBJECT' must start with a conventional prefix (feat:, fix:, docs:, test:, refactor:, chore:, build:, ci:)." >&2
  exit 1
fi

exit 0
