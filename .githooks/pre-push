#!/bin/sh
# Blocks direct pushes to main and non-fast-forward pushes.
set -eu

ZERO="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
    echo "REFUSED pre-push: Direct pushes to $remote_ref are forbidden. Fix: Push a <type>/<slug> feature branch and open a pull request." >&2
    exit 1
  fi

  if [ "$local_sha" = "$ZERO" ]; then
    echo "REFUSED pre-push: Deleting remote refs via git push is forbidden. Fix: Use gh pr merge --squash --delete-branch." >&2
    exit 1
  fi

  if [ "$remote_sha" != "$ZERO" ]; then
    # Without the remote tip locally the ancestry check cannot run, and a
    # force push could overwrite commits we have never seen. Fail closed.
    if ! git rev-parse --verify --quiet "$remote_sha^{commit}" >/dev/null; then
      echo "REFUSED pre-push: $remote_ref has commits you have not fetched. Fix: git fetch origin, merge or rebase onto it, then push again." >&2
      exit 1
    fi
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "REFUSED pre-push: Non-fast-forward (force) push to $remote_ref is forbidden. Fix: Pull/rebase cleanly or push a new commit." >&2
      exit 1
    fi
  fi
done

exit 0
