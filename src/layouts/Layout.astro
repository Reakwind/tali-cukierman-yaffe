---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui, type Locale } from '../i18n/ui';
import '../styles/site.css';
import { sectionHref, sectionTargets } from '../lib/section-navigation';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  pagePath?: string;
}

const {
  locale,
  title,
  description = ui[locale].description,
  pagePath = '',
} = Astro.props;
const t = ui[locale];
const other = locale === 'en' ? 'he' : 'en';
const home = getRelativeLocaleUrl(locale);
---

<!doctype html>
<html lang={locale} dir={locale === 'he' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={`${title} · ${t.groupName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={
        locale === 'he'
          ? '/fonts/plex-hebrew-regular.woff2'
          : '/fonts/lexend-latin.woff2'
      }
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title} · {t.groupName}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <header class="site-header" data-content-part="menu">
      <div class="container header-row">
        <a href={home} class="brand" aria-label={t.groupName}>
          <span>
            <span class="brand-name">{t.brand}</span>
            <span class="brand-subtitle">{t.group}</span>
          </span>
        </a>
        <nav class="desktop-nav" aria-label={t.mainNavigation}>
          {Object.entries(t.nav).map(([path, label]) => (
            <a
              href={sectionHref(locale, path)}
              data-section-link={sectionTargets[path]}
            >
              {label}
            </a>
          ))}
        </nav>
        <nav class="utility-nav" aria-label={t.audienceNav}>
          {Object.entries(t.audience).map(([path, label]) => (
            <a
              href={sectionHref(locale, path)}
              data-section-link={sectionTargets[path]}
            >
              {label}
            </a>
          ))}
        </nav>
        <details class="mobile-menu">
          <summary>
            {t.menu}
            <span aria-hidden="true">☰</span>
          </summary>
          <nav class="menu-panel" aria-label={t.mainNavigation}>
            {Object.entries(t.nav).map(([path, label]) => (
              <a
                href={sectionHref(locale, path)}
                data-section-link={sectionTargets[path]}
              >
                {label}
              </a>
            ))}
            <div class="menu-audience">
              {Object.entries(t.audience).map(([path, label]) => (
                <a
                  href={sectionHref(locale, path)}
                  data-section-link={sectionTargets[path]}
                >
                  {label}
                </a>
              ))}
            </div>
          </nav>
        </details>
        <a
          class="language-link"
          href={getRelativeLocaleUrl(other, pagePath)}
          lang={other}
          hreflang={other}
          dir={other === 'he' ? 'rtl' : 'ltr'}
        >
          {other === 'he' ? 'עברית' : 'English'}
        </a>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" data-content-part="footer">
      <slot name="footer-content" />
      <div class="container footer-grid">
        <div class="footer-intro">
          <p class="footer-group-name">{t.groupName}</p>
          <p class="footer-statement">{t.footerNote}</p>
        </div>
        <div>
          <h2 class="footer-heading">{t.footerKnow}</h2>
          <ul class="footer-links">
            <li>
              <a
                href={sectionHref(locale, 'privacy')}
                data-section-link="privacy"
              >
                {t.privacy}
              </a>
            </li>
            <li>
              <a
                href={sectionHref(locale, 'accessibility')}
                data-section-link="accessibility"
              >
                {t.accessibility}
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>
          © {new Date().getFullYear()} · {t.groupName}
        </span>
        <span>
          {locale === 'he'
            ? 'סוכרת · קוגניציה · הזדקנות בריאה'
            : 'Diabetes · Cognition · Healthy aging'}
        </span>
      </div>
    </footer>
  </body>
</html>
