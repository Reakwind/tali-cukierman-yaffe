---
interface Props {
  id: string;
  title: string;
  intro?: string;
}
const { id, title, intro } = Astro.props;
---

<section
  id={id}
  class="scroll-section"
  data-scroll-section
  tabindex="-1"
  aria-labelledby={`${id}-title`}
>
  <div class="container chapter-layout">
    <header class="chapter-heading" data-reveal>
      <h2 id={`${id}-title`}>{title}</h2>
      {intro && <p>{intro}</p>}
    </header>
    <div class="chapter-body">
      <slot />
    </div>
  </div>
</section>
<style>
  .scroll-section {
    padding-block: 3.5rem;
    border-block-start: 1px solid var(--line);
  }
  .chapter-layout {
    display: grid;
    grid-template-columns: minmax(170px, 0.65fr) minmax(0, 2fr);
    gap: 4rem;
    align-items: start;
  }
  .chapter-heading h2 {
    font-size: 1.7rem;
    margin-block-end: 1rem;
  }
  .chapter-heading p {
    font-size: 0.85rem;
    color: var(--muted);
    max-inline-size: 30ch;
  }
  .chapter-body {
    min-inline-size: 0;
  }
  .chapter-body :global(p),
  .chapter-body :global(li) {
    max-inline-size: 75ch;
  }
  @media (min-width: 1100px) and (min-height: 700px) {
    .chapter-heading {
      position: sticky;
      inset-block-start: calc(var(--header-clearance) + 1rem);
    }
  }
  @media (max-width: 1099px) {
    .chapter-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .chapter-heading p {
      max-inline-size: 65ch;
    }
  }
  @media (max-width: 650px) {
    .scroll-section {
      padding-block: 2.5rem;
    }
  }
  @media print {
    .chapter-heading {
      position: static;
    }
  }
</style>
