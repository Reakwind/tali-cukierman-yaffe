---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui, type Locale } from '../i18n/ui';
import StudyName from './StudyName.astro';

interface Props {
  study: CollectionEntry<'studies'>;
  locale: Locale;
  compact?: boolean;
}
const { study, locale, compact = false } = Astro.props;
const t = ui[locale];
const data = study.data;
const content = data.localized[locale];
const closed = data.registryStatus === 'COMPLETED';
const Heading = compact ? 'h3' : 'h2';
const updated = new Intl.DateTimeFormat(locale === 'he' ? 'he-IL' : 'en-GB', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(new Date(`${data.registryUpdated}T00:00:00Z`));
---

<article
  class:list={['study-card', { 'study-card--compact': compact }]}
  id={study.id}
  data-study={study.id}
  data-status={data.registryStatus}
>
  <span class:list={['status', { 'status-closed': closed }]}>
    {closed ? t.completed : t.recruiting}
  </span>
  <Heading>
    <StudyName title={content.title} acronym={data.acronym} />
  </Heading>
  <p>{content.summary}</p>
  <dl class="study-facts">
    <div>
      <dt>
        {compact
          ? locale === 'he'
            ? 'משך המחקר'
            : 'Study duration'
          : t.record}
      </dt>
      <dd>
        {compact ? content.duration : <bdi dir="ltr">{data.registryId}</bdi>}
      </dd>
    </div>
    <div>
      <dt>{t.updated}</dt>
      <dd>
        <time datetime={data.registryUpdated}>{updated}</time>
      </dd>
    </div>
  </dl>
  <a
    class="text-link"
    href={getRelativeLocaleUrl(locale, `studies/${study.id}/`)}
  >
    {t.readStudy}
    <span class="arrow" aria-hidden="true">
      →
    </span>
  </a>
</article>
