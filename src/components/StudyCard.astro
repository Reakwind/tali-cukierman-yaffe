---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui, type Locale } from '../i18n/ui';
import StudyName from './StudyName.astro';
import ResearchText from './ResearchText.astro';

interface Props {
  study: CollectionEntry<'studies'>;
  locale: Locale;
  compact?: boolean;
}
const { study, locale, compact = false } = Astro.props;
const t = ui[locale];
const data = study.data;
const content = data.localized[locale];
const recruiting = Boolean(data.recruitment);
const project = data.kind === 'project';
const Heading = compact ? 'h3' : 'h2';
const updated = new Intl.DateTimeFormat(locale === 'he' ? 'he-IL' : 'en-GB', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(
  new Date(
    `${data.recruitment?.confirmedOn ?? (data.kind === 'trial' ? data.registryUpdated : data.sourceChecked)}T00:00:00Z`,
  ),
);
---

<article
  class:list={['study-card', { 'study-card--compact': compact }]}
  id={study.id}
  data-study={study.id}
  data-status={data.registryStatus}
>
  {recruiting && !compact && <span class="status">{t.recruiting}</span>}
  <Heading>
    {compact ? (
      <a href={getRelativeLocaleUrl(locale, `studies/${study.id}/`)}>
        <ResearchText text={data.acronym ?? content.title} />
      </a>
    ) : (
      <StudyName title={content.title} acronym={data.acronym} />
    )}
  </Heading>
  <p>
    <ResearchText
      text={
        compact ? (content.homepageSummary ?? content.summary) : content.summary
      }
    />
  </p>
  {!compact && (
    <dl class="study-facts">
      {!compact && data.kind === 'trial' && (
        <div>
          <dt>{t.record}</dt>
          <dd>
            <bdi dir="ltr">{data.registryId}</bdi>
          </dd>
        </div>
      )}
      <div>
        <dt>
          {recruiting
            ? t.recruitmentConfirmed
            : project
              ? t.sourceChecked
              : t.updated}
        </dt>
        <dd>
          <time
            datetime={
              data.recruitment?.confirmedOn ??
              (data.kind === 'trial'
                ? data.registryUpdated
                : data.sourceChecked)
            }
          >
            {updated}
          </time>
        </dd>
      </div>
    </dl>
  )}
  {!compact && (
    <a
      class:list={['text-link', { button: recruiting }]}
      href={`${getRelativeLocaleUrl(locale, `studies/${study.id}/`)}${recruiting ? '#taking-part' : ''}`}
    >
      {recruiting ? t.learnParticipation : t.readStudy}
      <span class="arrow" aria-hidden="true">
        →
      </span>
    </a>
  )}
</article>
