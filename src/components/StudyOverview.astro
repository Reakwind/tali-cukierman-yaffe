---
import type { CollectionEntry } from 'astro:content';
import { ui, type Locale } from '../i18n/ui';
import ResearchText from './ResearchText.astro';
import StudyName from './StudyName.astro';
interface Props {
  study: CollectionEntry<'studies'>;
  locale: Locale;
}
const { study, locale } = Astro.props;
const data = study.data;
const content = data.localized[locale];
const t = ui[locale];
const project = data.kind === 'project';
const recruiting = Boolean(data.recruitment);
const fields = [
  [
    project
      ? t.projectPopulation
      : recruiting
        ? t.population
        : t.completedPopulation,
    content.population,
  ],
  [
    project ? t.projectLocation : recruiting ? t.location : t.completedLocation,
    content.location,
  ],
  [
    project ? t.projectDuration : recruiting ? t.duration : t.completedDuration,
    content.duration,
  ],
];
---

<article
  id={`study-${study.id}`}
  class="study-overview"
  data-study={study.id}
  aria-labelledby={`study-${study.id}-title`}
  tabindex="-1"
>
  <h3 id={`study-${study.id}-title`}>
    <StudyName title={content.title} acronym={data.acronym} />
  </h3>
  <p class="study-summary">
    <ResearchText text={content.homepageSummary ?? content.summary} />
  </p>
  <div data-study-details>
    {fields.map(([label, value]) => (
      <section>
        <h4>{label}</h4>
        <p>
          <ResearchText text={value!} />
        </p>
      </section>
    ))}
    <section>
      <h4>
        {project
          ? t.projectInvolves
          : recruiting
            ? t.involves
            : t.completedInvolves}
      </h4>
      <ul>
        {content.activities.map((activity) => (
          <li>
            <ResearchText text={activity} />
          </li>
        ))}
      </ul>
    </section>
    <section>
      <h4>{t.researchDetails}</h4>
      {content.research.map((paragraph) => (
        <p>
          <ResearchText text={paragraph} />
        </p>
      ))}
    </section>
    <p class="study-reference">
      {data.kind === 'trial' && (
        <>
          <bdi dir="ltr">{data.registryId}</bdi>
          {' · '}
        </>
      )}
      {t.sourceChecked}:{' '}
      <time datetime={data.sourceChecked}>
        {new Intl.DateTimeFormat(locale === 'he' ? 'he-IL' : 'en-GB', {
          dateStyle: 'long',
          timeZone: 'UTC',
        }).format(new Date(`${data.sourceChecked}T00:00:00Z`))}
      </time>
    </p>
  </div>
</article>
<style>
  .study-overview + .study-overview {
    margin-block-start: 3rem;
    padding-block-start: 2.5rem;
    border-block-start: 1px solid var(--line-strong);
  }
  h3 {
    font-size: 1.55rem;
    line-height: 1.35;
  }
  h4 {
    font-size: 0.9rem;
    margin-block: 1.5rem 0.4rem;
    font-weight: 600;
  }
  p,
  li {
    font-size: 0.9rem;
  }
  .study-summary {
    font-size: 1rem;
    color: var(--muted);
  }
  .study-reference {
    font-size: 0.72rem;
    color: var(--muted);
    margin-block: 1.5rem 0;
  }
</style>
