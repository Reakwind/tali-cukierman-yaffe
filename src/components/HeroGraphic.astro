---
import type { Locale } from '../i18n/ui';
interface Props {
  locale: Locale;
  idPrefix?: string;
}
const { locale, idPrefix = 'hero-art' } = Astro.props;
const signalPath =
  'M64 490H240Q268 490 268 462V416Q268 390 294 390H576Q602 390 602 418V476Q602 504 630 504H856';
---

<svg
  viewBox="0 0 920 800"
  width="920"
  height="800"
  class="hero-graphic"
  data-art-direction="geometric-devices"
  role="img"
  aria-labelledby={`${idPrefix}-title`}
>
  <title id={`${idPrefix}-title`}>
    {
      locale === 'he'
        ? 'איור מחקרי: עט אינסולין, סמלי הערכה קוגניטיבית וקו אות רציף'
        : 'Research illustration: insulin pen, cognitive assessment symbols and continuous signal trace'
    }
  </title>
  <defs>
    <pattern
      id={`${idPrefix}-grid`}
      width="44"
      height="44"
      patternUnits="userSpaceOnUse"
    >
      <circle cx="4" cy="4" r="1.4" fill="var(--teal)" fill-opacity=".22" />
    </pattern>
  </defs>
  <g class="parallax-layer layer-far" data-parallax-layer="far">
    <rect
      x="90"
      y="110"
      width="740"
      height="580"
      rx="28"
      fill="var(--teal-soft)"
    />
    <rect
      x="90"
      y="110"
      width="740"
      height="580"
      rx="28"
      fill={`url(#${idPrefix}-grid)`}
    />
    <path
      d="M210 350A210 210 0 0 1 630 350"
      fill="none"
      stroke="var(--magenta-soft)"
      stroke-width="68"
    />
    <path
      d="M64 670H170M64 670V564M856 130H750M856 130V236"
      fill="none"
      stroke="var(--teal)"
      stroke-width="2"
    />
  </g>
  <g class="parallax-layer layer-middle" data-parallax-layer="middle">
    <path
      d={signalPath}
      fill="none"
      stroke="var(--magenta-soft)"
      stroke-width="18"
      stroke-linecap="round"
    />
    <path
      class="hero-detail signal-trace"
      data-scroll-detail="signal"
      pathLength="1"
      d={signalPath}
      fill="none"
      stroke="var(--magenta)"
      stroke-width="4"
    />
    <circle cx="64" cy="490" r="8" fill="var(--magenta)" />
    <circle cx="856" cy="504" r="8" fill="var(--magenta)" />
    <circle
      cx="435"
      cy="390"
      r="156"
      fill="var(--paper)"
      stroke="var(--teal)"
      stroke-width="2"
    />
    <circle cx="435" cy="390" r="128" fill="var(--teal-paper)" />
    <circle
      cx="435"
      cy="390"
      r="94"
      fill="none"
      stroke="var(--teal-soft)"
      stroke-width="28"
    />
    <circle
      cx="435"
      cy="390"
      r="140"
      fill="none"
      stroke="var(--teal)"
      stroke-opacity=".16"
      stroke-dasharray="4 9"
    />
    <g stroke="var(--teal)" stroke-width="2" stroke-opacity=".45">
      {Array.from({ length: 24 }, (_, index) => (
        <path d="M435 256V262" transform={`rotate(${index * 15} 435 390)`} />
      ))}
    </g>
    <rect
      x="381"
      y="368"
      width="108"
      height="44"
      rx="22"
      fill="var(--magenta-soft)"
    />
    <circle cx="435" cy="390" r="9" fill="var(--magenta)" />
    <path
      d="M598 242Q630 210 662 242M610 256Q630 236 650 256"
      fill="none"
      stroke="var(--teal)"
      stroke-width="3"
      stroke-linecap="round"
    />
  </g>
  <g class="parallax-layer layer-near" data-parallax-layer="near">
    <g class="hero-detail" data-scroll-detail="pen">
      <g transform="rotate(-10 176 450)" stroke="var(--teal)" stroke-width="2">
        <rect
          x="146"
          y="330"
          width="60"
          height="220"
          rx="12"
          fill="var(--paper)"
        />
        <path
          d="M146 382H206V342Q206 330 194 330H158Q146 330 146 342Z"
          fill="var(--magenta-soft)"
        />
        <path
          d="M146 510H206V538Q206 550 194 550H158Q146 550 146 538Z"
          fill="var(--teal-soft)"
        />
        <rect
          x="166"
          y="404"
          width="20"
          height="70"
          rx="5"
          fill="var(--teal-soft)"
        />
        <path d="M161 350V370M176 344V372M191 350V370" />
        <path d="M176 330V304" stroke="var(--magenta)" stroke-width="3" />
        <circle cx="176" cy="298" r="5" fill="var(--magenta)" stroke="none" />
      </g>
    </g>
    <g
      class="hero-detail"
      data-scroll-detail="symbols"
      stroke="var(--teal)"
      stroke-width="2"
    >
      <rect
        x="626"
        y="250"
        width="176"
        height="176"
        rx="20"
        fill="var(--paper)"
      />
      <rect
        x="654"
        y="278"
        width="52"
        height="52"
        rx="8"
        fill="var(--teal-soft)"
      />
      <circle cx="750" cy="304" r="26" fill="var(--magenta-soft)" />
      <path d="M680 392L708 344L736 392Z" fill="var(--teal-soft)" />
      <path d="M752 350V388M733 369H771" stroke="var(--magenta)" />
      <g transform="translate(652 464)">
        <rect x="0" y="0" width="148" height="88" rx="18" fill="var(--paper)" />
        <circle cx="44" cy="44" r="24" fill="var(--magenta-soft)" />
        <circle cx="44" cy="44" r="7" fill="var(--magenta)" stroke="none" />
        <path d="M84 30H126M84 44H116M84 58H122" />
      </g>
    </g>
  </g>
</svg>
<style>
  .hero-graphic {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }
  .signal-trace {
    stroke-dasharray: 0.28 0.12;
  }
</style>
