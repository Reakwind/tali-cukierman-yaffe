---
import type { Locale } from '../i18n/ui';
interface Props {
  locale: Locale;
  idPrefix?: string;
}
const { locale, idPrefix = 'hero-art' } = Astro.props;
const signalPath =
  'M86 492H240Q278 492 278 454V396Q278 358 316 358H692Q730 358 730 396V450Q730 488 768 488H846';
---

<svg
  class="hero-graphic"
  data-art-direction="geometric-devices"
  viewBox="0 0 900 800"
  width="900"
  height="800"
  role="img"
  aria-labelledby={`${idPrefix}-title`}
>
  <title
    id={`${idPrefix}-title`}
  >{locale === 'he' ? 'איור גאומטרי של חיישן סוכר, עט הזרקה וסמלים להערכה דיגיטלית' : 'A geometric illustration of a glucose sensor, injection pen and digital-assessment symbols'}</title>
  <defs>
    <pattern
      id={`${idPrefix}-grid`}
      width="40"
      height="40"
      patternUnits="userSpaceOnUse"
    >
      <path
        d="M40 0H0V40"
        fill="none"
        stroke="var(--teal)"
        stroke-opacity=".08"
        stroke-width="1"
      />
    </pattern>
  </defs>
  <g class="parallax-layer layer-far" data-parallax-layer="far">
    <rect
      x="125"
      y="120"
      width="680"
      height="610"
      rx="24"
      fill="var(--teal-soft)"
    />
    <rect
      x="125"
      y="120"
      width="680"
      height="610"
      rx="24"
      fill={`url(#${idPrefix}-grid)`}
    />
    <path
      d="M190 270A240 240 0 0 1 670 270"
      fill="none"
      stroke="var(--magenta-soft)"
      stroke-width="96"
    />
    <path
      d="M84 655H208M84 655V530M842 170H718M842 170V295"
      fill="none"
      stroke="var(--teal)"
      stroke-width="2"
    />
  </g>
  <g class="parallax-layer layer-middle" data-parallax-layer="middle">
    <path
      d={signalPath}
      fill="none"
      stroke="var(--line-strong)"
      stroke-width="1.5"
    />
    <path
      class="hero-detail signal-path"
      data-scroll-detail="signal"
      pathLength="1"
      stroke-dasharray="1"
      d={signalPath}
      fill="none"
      stroke="var(--magenta)"
      stroke-width="3"
    />
    <circle cx="86" cy="492" r="8" fill="var(--magenta)" />
    <circle cx="846" cy="488" r="8" fill="var(--magenta)" />
    <circle
      cx="510"
      cy="350"
      r="180"
      fill="var(--paper)"
      stroke="var(--teal)"
      stroke-width="2"
    />
    <circle cx="510" cy="350" r="150" fill="var(--teal-paper)" />
    <circle
      cx="510"
      cy="350"
      r="112"
      fill="none"
      stroke="var(--teal-soft)"
      stroke-width="34"
    />
    <circle
      cx="510"
      cy="350"
      r="163"
      fill="none"
      stroke="var(--teal)"
      stroke-opacity=".16"
      stroke-width="1"
    />
    <g stroke="var(--teal)" stroke-width="2" stroke-opacity=".45">
      {Array.from({ length: 24 }, (_, index) => (
        <path d="M510 198V204" transform={`rotate(${index * 15} 510 350)`} />
      ))}
    </g>
    <rect
      x="450"
      y="326"
      width="120"
      height="48"
      rx="24"
      fill="var(--magenta-soft)"
    />
    <circle cx="510" cy="350" r="9" fill="var(--magenta)" />
    <path
      d="M700 204Q732 172 764 204M712 218Q732 198 752 218"
      fill="none"
      stroke="var(--teal)"
      stroke-width="3"
      stroke-linecap="round"
    />
  </g>
  <g class="parallax-layer layer-near" data-parallax-layer="near">
    <g class="hero-detail" data-scroll-detail="pen">
      <g transform="rotate(-18 205 600)" stroke="var(--teal)" stroke-width="2">
        <rect
          x="172"
          y="440"
          width="66"
          height="266"
          rx="12"
          fill="var(--paper)"
        />
        <path
          d="M172 500H238V452Q238 440 226 440H184Q172 440 172 452Z"
          fill="var(--magenta-soft)"
        />
        <path
          d="M172 656H238V694Q238 706 226 706H184Q172 706 172 694Z"
          fill="var(--teal-soft)"
        />
        <rect
          x="194"
          y="524"
          width="22"
          height="84"
          rx="5"
          fill="var(--teal-soft)"
        />
        <path
          d="M194 548H216M194 572H216M194 596H216M188 706V726H222V706M205 726V750"
          fill="none"
        />
      </g>
    </g>
    <g
      class="hero-detail"
      data-scroll-detail="symbols"
      stroke="var(--teal)"
      stroke-width="2"
    >
      <rect
        x="614"
        y="566"
        width="216"
        height="164"
        rx="12"
        fill="var(--paper)"
      />
      <path d="M634 638H810" stroke="var(--line)" stroke-width="1" />
      <circle cx="656" cy="610" r="14" fill="var(--magenta-soft)" />
      <rect
        x="704"
        y="596"
        width="28"
        height="28"
        rx="3"
        fill="var(--teal-soft)"
      />
      <path d="M778 594L794 610L778 626L762 610Z" fill="var(--magenta-soft)" />
      <rect
        x="642"
        y="654"
        width="28"
        height="28"
        rx="3"
        fill="var(--teal-soft)"
      />
      <path d="M704 668H732M718 654V682" fill="none" />
      <circle cx="778" cy="668" r="14" fill="var(--magenta-soft)" />
    </g>
  </g>
</svg>
<style>
  .hero-graphic {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }
</style>
