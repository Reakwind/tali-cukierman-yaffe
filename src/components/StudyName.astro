---
import ResearchText from './ResearchText.astro';
interface Props {
  title: string;
  acronym?: string | undefined;
}
const { title, acronym } = Astro.props;
const parts = acronym ? title.split(acronym) : [];
---

{acronym && parts.length === 2 ? (
  <Fragment>
    <ResearchText text={parts[0] ?? ''} />
    <bdi class="study-acronym" dir="ltr">
      {acronym}
    </bdi>
    <ResearchText text={parts[1] ?? ''} />
  </Fragment>
) : (
  <ResearchText text={title} />
)}
