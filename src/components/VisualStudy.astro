---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';
import DiabetesIcon from './DiabetesIcon.astro';
interface Props {
  study: CollectionEntry<'studies'>;
  visual: CollectionEntry<'visualStudies'>;
  locale: Locale;
}
const { study, visual, locale } = Astro.props;
const he = locale === 'he';
const data = visual.data;
if (data.kind === 'methods') {
  throw new Error('Methods record cannot be rendered as a study card.');
}
const copy = data.localized[locale];
const checked = new Intl.DateTimeFormat(he ? 'he-IL' : 'en-GB', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(new Date(`${data.sourceChecked}T00:00:00Z`));
const trialCopy = data.kind === 'trial' ? data.localized[locale] : null;
const assessmentCopy =
  data.kind === 'assessment' ? data.localized[locale] : null;
---

<article
  id={`study-${study.id}`}
  class={`visual-study parallax-scene visual-study--${data.kind}`}
  data-study={study.id}
  aria-labelledby={`study-${study.id}-title`}
>
  <div class="study-layout">
    <header class="study-lead">
      <p class="status">{he ? 'מגייסים משתתפים' : 'Now recruiting'}</p>
      <h3 id={`study-${study.id}-title`}>
        <bdi dir="ltr">{study.data.acronym}</bdi>
      </h3>
      <p class="study-question">{copy.lead}</p>
      <div class="audience-Fact">
        <DiabetesIcon name="contact" size={44} />
        <span>{copy.audience}</span>
      </div>
      {trialCopy && (
        <>
          <p class="dietitian-note">
            <DiabetesIcon name="nutrition" size={44} />
            <span>{trialCopy.dietitian}</span>
          </p>
          <ul class="feature-grid feature-grid--compact">
            {trialCopy.features.map((feature) => (
              <li>
                <DiabetesIcon name={feature.icon} size={42} />
                <span>{feature.label}</span>
              </li>
            ))}
          </ul>
        </>
      )}
      {assessmentCopy && (
        <>
          <div class="visit-note">
            <DiabetesIcon name="conversation" size={44} />
            <p>{copy.visitNote}</p>
          </div>
          <p class="study-partnership">
            {assessmentCopy.partnership} ·{' '}
            <bdi dir="ltr">{assessmentCopy.funding}</bdi>
          </p>
        </>
      )}
      <p class="source-stamp">
        {'registryId' in study.data && (
          <>
            <bdi dir="ltr">{study.data.registryId}</bdi>
            {' · '}
          </>
        )}
        {he ? 'המידע נבדק' : 'Information checked'}{' '}
        <time datetime={data.sourceChecked}>{checked}</time>
      </p>
    </header>

    <div class="study-figure" data-study-details>
      <div
        class="study-plate-far parallax-layer layer-far"
        data-parallax-layer="far"
        aria-hidden="true"
      ></div>
      <div
        class="study-plate-mid parallax-layer layer-middle"
        data-parallax-layer="middle"
        aria-hidden="true"
      ></div>
      <div
        class="study-diagram-surface parallax-layer layer-near"
        data-parallax-layer="near"
      >
        {data.kind === 'trial' && trialCopy && (
          <div class="trial-diagram">
            <div class="study-shared">
              <DiabetesIcon name="injection" size={56} />
              <strong>{trialCopy.treatment}</strong>
              <span>{trialCopy.allocation}</span>
              <svg class="branch-lines" viewBox="0 0 360 36" aria-hidden="true">
                <path d="M180 2V18M65 18H295M65 18V34M295 18V34" />
              </svg>
            </div>
            <div class="study-branches">
              <div class="study-arm study-arm--active">
                <div class="arm-icons">
                  <DiabetesIcon name="fitness" size={68} />
                  <DiabetesIcon name="nutrition" size={68} />
                </div>
                <strong>{trialCopy.intervention}</strong>
              </div>
              <div class="study-arm">
                <DiabetesIcon name="conversation" size={68} />
                <strong>{trialCopy.control}</strong>
              </div>
            </div>
            <div
              class="study-timeline"
              aria-label={he ? 'ביקורי הערכה' : 'Assessment visits'}
            >
              <div class="timeline-head">
                <strong>
                  {data.durationWeeks} {he ? 'שבועות' : 'weeks'}
                </strong>
              </div>
              <ol class="visit-track">
                {data.assessmentWeeks.map((week) => (
                  <li data-visit-week={week}>
                    <span class="visit-dot" aria-hidden="true" />
                    <strong>{week}</strong>
                  </li>
                ))}
              </ol>
              <p class="timeline-note">{copy.visitNote}</p>
            </div>
            <div class="weekly-plan">
              <h4>{trialCopy.weeklyTitle}</h4>
              <div class="weekly-items">
                <div>
                  <DiabetesIcon name="fitness" size={58} />
                  <strong>
                    <bdi dir="ltr">
                      {data.weekly.guided} × {data.weekly.guidedMinutes} min
                    </bdi>
                  </strong>
                  <span>{trialCopy.guided}</span>
                </div>
                <div>
                  <DiabetesIcon name="strength" size={58} />
                  <strong>{data.weekly.home}</strong>
                  <span>{trialCopy.home}</span>
                </div>
                <div>
                  <DiabetesIcon name="phone" size={58} />
                  <strong>{data.weekly.calls}</strong>
                  <span>{trialCopy.calls}</span>
                </div>
              </div>
            </div>
          </div>
        )}
        {data.kind === 'assessment' && assessmentCopy && (
          <div class="assessment-diagram">
            <div class="assessment-hub">
              <DiabetesIcon name="computer" size={140} />
              <span>{he ? 'למידת מכונה' : 'Machine learning'}</span>
            </div>
            <ul class="feature-grid feature-grid--assessment">
              {assessmentCopy.features.map((feature) => (
                <li>
                  <DiabetesIcon name={feature.icon} size={96} />
                  <span>{feature.label}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
</article>
<style>
  .visual-study {
    padding-block: 3rem;
    border-block-start: 2px solid var(--teal);
  }
  .study-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr);
    gap: 2.5rem;
    align-items: start;
  }
  .study-lead {
    position: sticky;
    inset-block-start: calc(var(--header-clearance) + 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .status {
    color: var(--teal);
    font-size: 0.75rem;
    font-weight: 600;
    margin: 0;
  }
  h3 {
    font-size: clamp(2.1rem, 3.6vw, 3rem);
    margin: 0;
    line-height: 1.02;
  }
  .study-question {
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
  }
  .audience-Fact,
  .visit-note,
  .dietitian-note {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    font-size: 0.82rem;
  }
  .visit-note p {
    margin: 0;
  }
  .study-figure {
    position: relative;
    padding: 1.75rem;
    min-inline-size: 0;
  }
  .study-plate-far {
    position: absolute;
    inset: 0.5rem 0.5rem 1.5rem 0.5rem;
    border-radius: 26px;
    background: var(--teal-paper);
    z-index: 0;
  }
  .study-plate-mid {
    position: absolute;
    inset: 1.25rem 1.25rem 0.75rem 1.25rem;
    border-radius: 22px;
    border: 1.5px dashed var(--line-strong);
    z-index: 1;
  }
  .study-diagram-surface {
    position: relative;
    z-index: 2;
  }
  .trial-diagram {
    display: grid;
    gap: 1.15rem;
  }
  .study-shared {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    padding: 0.85rem 1rem 0.25rem;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    text-align: center;
  }
  .study-shared strong {
    font-size: 0.88rem;
  }
  .study-shared span {
    font-size: 0.72rem;
    color: var(--muted);
  }
  .branch-lines {
    inline-size: min(320px, 82%);
    block-size: 26px;
  }
  .branch-lines path {
    stroke: var(--teal);
    stroke-width: 2;
    fill: none;
  }
  .study-branches {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .study-arm {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.9rem;
    background: var(--magenta-soft);
    border-radius: 16px;
    text-align: center;
  }
  .study-arm strong {
    font-size: 0.85rem;
  }
  .study-arm--active {
    background: var(--teal-soft);
  }
  .arm-icons {
    display: flex;
    gap: 0.35rem;
  }
  .study-timeline {
    padding: 1rem 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: var(--paper);
  }
  .timeline-head {
    margin-block-end: 0.65rem;
    font-size: 0.85rem;
  }
  .visit-track {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    position: relative;
  }
  .visit-track::before {
    content: '';
    position: absolute;
    inset-inline: 12%;
    inset-block-start: 9px;
    border-block-start: 2px solid var(--teal);
  }
  .visit-track li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font-size: 0.72rem;
  }
  .visit-dot {
    inline-size: 18px;
    block-size: 18px;
    border-radius: 50%;
    background: var(--magenta-soft);
    border: 2px solid var(--magenta);
  }
  .timeline-note {
    font-size: 0.76rem;
    color: var(--muted);
    margin: 0.7rem 0 0;
  }
  .weekly-plan {
    padding: 1rem 1.25rem;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 16px;
  }
  .weekly-plan h4 {
    font-size: 0.82rem;
    margin-block: 0 0.65rem;
  }
  .weekly-items {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .weekly-items div {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.2rem;
    padding: 0.65rem;
    background: var(--teal-paper);
    border-radius: 12px;
  }
  .weekly-items strong {
    font-size: 0.82rem;
    color: var(--teal);
  }
  .weekly-items span {
    font-size: 0.72rem;
  }
  .feature-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .feature-grid li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.76rem;
  }
  .feature-grid :global(svg) {
    flex: 0 0 auto;
  }
  .assessment-diagram {
    display: grid;
    grid-template-columns: 0.95fr 1.25fr;
    gap: 1.25rem;
    align-items: center;
    padding: 1rem;
  }
  .assessment-hub {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 1.5rem 1rem;
    background: var(--paper);
    border: 1px solid var(--teal);
    border-radius: 18px;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .feature-grid--assessment {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .feature-grid--assessment li {
    flex-direction: column;
    text-align: center;
    padding: 1.15rem 0.75rem;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 16px;
  }
  .study-partnership,
  .source-stamp {
    font-size: 0.74rem;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 950px) {
    .study-layout,
    .assessment-diagram {
      grid-template-columns: 1fr;
    }
    .study-lead {
      position: relative;
      inset-block-start: auto;
    }
  }
  @media (max-width: 650px) {
    .visual-study {
      padding-block: 2rem;
    }
    .study-figure {
      padding: 0.75rem;
    }
    .study-branches,
    .weekly-items,
    .feature-grid,
    .feature-grid--assessment {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .study-lead {
      position: relative;
      inset-block-start: auto;
    }
  }
</style>
