---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../layouts/Layout.astro';
import AssessmentIllustration from './AssessmentIllustration.astro';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const he = locale === 'he';
const content = he
  ? {
      title: ['סוכרת,', 'קוגניציה והזדקנות.'],
      intro:
        'אנו חוקרים כיצד סוכרת קשורה לזיכרון, לחשיבה ולתפקוד גופני בגיל המבוגר.',
      role: 'אנדוקרינולוגית ואפידמיולוגית קלינית',
      institutions: ['המרכז הרפואי שיבא', 'אוניברסיטת תל אביב'],
      research: 'תחומי המחקר',
      researchIntro:
        'המחקר משלב אנדוקרינולוגיה, אפידמיולוגיה קלינית והערכת תפקוד.',
      areas: [
        {
          id: 'cognition',
          title: 'סוכרת ותפקוד קוגניטיבי',
          text: 'זיכרון וחשיבה בגיל המבוגר עם סוכרת.',
          studies: [{ id: 'hybrid-closed-loop', label: 'GRACE-780G' }],
        },
        {
          id: 'movement',
          title: 'כוח שריר ותפקוד גופני',
          text: 'כוח שריר, תפקוד גופני ושבריריות.',
          studies: [{ id: 'stay-strong', label: 'STAY-STRONG' }],
        },
        {
          id: 'technology',
          title: 'כלי הערכה דיגיטליים',
          text: 'כלי הערכה קוגניטיביים, כולל DSST דיגיטלי.',
        },
      ],
      relatedLabel: 'מחקר קשור',
      teamTitle: 'הצוות',
      teamText:
        'קבוצה בהובלת פרופ׳ טלי צוקרמן־יפה: קלינאים, חוקרים, רכזי מחקר וסטודנטים במרכז הרפואי שיבא ובאוניברסיטת תל אביב.',
      teamLink: 'הצוות',
    }
  : {
      title: ['Diabetes,', 'cognition & aging.'],
      intro:
        'We study how diabetes relates to memory, thinking, and physical function in older adults.',
      role: 'Endocrinologist & clinical epidemiologist',
      institutions: ['Sheba Medical Center', 'Tel Aviv University'],
      research: 'Research areas',
      researchIntro:
        'Our work combines endocrinology, clinical epidemiology, and functional assessment.',
      areas: [
        {
          id: 'cognition',
          title: 'Diabetes & cognitive function',
          text: 'Memory and thinking in older adults with diabetes.',
          studies: [{ id: 'hybrid-closed-loop', label: 'GRACE-780G' }],
        },
        {
          id: 'movement',
          title: 'Muscle strength & physical function',
          text: 'Muscle strength, physical function, and frailty.',
          studies: [{ id: 'stay-strong', label: 'STAY-STRONG' }],
        },
        {
          id: 'technology',
          title: 'Digital assessment tools',
          text: 'Cognitive assessment tools, including a digital DSST.',
        },
      ],
      relatedLabel: 'Related study',
      teamTitle: 'The team',
      teamText:
        'A group led by Prof. Tali Cukierman-Yaffe: clinicians, researchers, coordinators, and students at Sheba Medical Center and Tel Aviv University.',
      teamLink: 'The team',
    };
---

<Layout
  locale={locale}
  title={he ? 'סוכרת, קוגניציה והזדקנות' : 'Diabetes, cognition & aging'}
>
  <section class="container home-intro" aria-labelledby="home-title">
    <div class="intro-copy">
      <p class="group-byline">
        {t.fullName}
        <span>{content.role}</span>
      </p>
      <h1 id="home-title">
        {content.title.map((line) => (
          <span>{line}</span>
        ))}
      </h1>
      <p class="intro-text">{content.intro}</p>
      <div class="intro-actions">
        <a class="button" href={getRelativeLocaleUrl(locale, 'studies/')}>
          {t.explore}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="intro-visual">
      <AssessmentIllustration locale={locale} />
    </div>
    <div class="institution-links">
      <span>{content.institutions[0]}</span>
      <span aria-hidden="true">/</span>
      <span>{content.institutions[1]}</span>
    </div>
  </section>

  <section
    id="home-research"
    class="research-section"
    aria-labelledby="research-title"
  >
    <div class="container research-layout">
      <div class="research-intro">
        <h2 id="research-title">{content.research}</h2>
        <p>{content.researchIntro}</p>
      </div>
      <div class="research-list">
        {content.areas.map((area) => (
          <article>
            <h3>
              <a
                href={`${getRelativeLocaleUrl(locale, 'research/')}#${area.id}`}
              >
                {area.title}
                <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p>{area.text}</p>
            {area.studies && (
              <p class="area-studies">
                <span>{content.relatedLabel}</span>
                {area.studies.map((s) => (
                  <a
                    class="study-link"
                    href={getRelativeLocaleUrl(locale, `studies/${s.id}/`)}
                  >
                    {s.label}
                    <span aria-hidden="true">→</span>
                  </a>
                ))}
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    id="home-team"
    class="container home-team"
    aria-labelledby="home-team-title"
  >
    <h2 id="home-team-title">{content.teamTitle}</h2>
    <p>{content.teamText}</p>
    <a class="text-link" href={getRelativeLocaleUrl(locale, 'about/')}>
      {content.teamLink}
      <span aria-hidden="true">→</span>
    </a>
  </section>
</Layout>

<style>
  .home-intro {
    padding-block: 4.5rem 1.5rem;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    column-gap: 3.5rem;
    align-items: center;
  }
  .group-byline {
    font-size: 0.78rem;
    line-height: 1.6;
    font-weight: 600;
    margin-block-end: 1.6rem;
  }
  .group-byline span {
    display: block;
    color: var(--muted);
    font-weight: 400;
  }
  h1 {
    font-size: clamp(2.7rem, 4.4vw, 4rem);
    line-height: 1.09;
    letter-spacing: -0.045em;
    margin-block-end: 1.75rem;
    font-weight: 500;
  }
  h1 span {
    display: block;
  }
  .intro-text {
    font-size: 1.07rem;
    max-inline-size: 40ch;
    line-height: 1.6;
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-block: 1.8rem 1rem;
  }
  .intro-actions .text-link {
    font-size: 0.78rem;
  }
  .intro-visual {
    align-self: center;
    padding-block-start: 2rem;
  }
  .institution-links {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
    border-block-end: 1px solid var(--line);
    padding-block: 2.25rem 1.4rem;
    font-size: 0.76rem;
    color: var(--muted);
  }
  .institution-links a {
    text-decoration: none;
  }
  .institution-links a:hover {
    text-decoration: underline;
  }
  .research-section {
    background: var(--mist);
    padding-block: 4rem;
  }
  .research-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 6rem;
  }
  .research-intro p {
    max-inline-size: 32ch;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .research-list article {
    padding-block: 1.3rem;
    border-block-start: 1px solid var(--line-strong);
  }
  .research-list article:first-child {
    padding-block-start: 0;
    border-block-start: none;
  }
  .research-list article:last-child {
    padding-block-end: 0;
  }
  .research-list h3 {
    font-size: 1.1rem;
    margin-block-end: 0.6rem;
  }
  .research-list h3 a {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
  }
  .research-list h3 a:hover {
    text-decoration: underline;
  }
  .research-list h3 span {
    font-weight: 400;
    font-family: Arial, sans-serif;
  }
  .research-list p {
    font-size: 0.88rem;
    color: var(--muted);
    margin-block-end: 0;
    max-inline-size: 52ch;
  }
  .area-studies {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin-block-start: 0.85rem;
    font-size: 0.78rem;
  }
  .area-studies > span {
    color: var(--muted);
  }
  .area-studies .study-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-block-size: 44px;
    font-weight: 500;
    text-decoration: none;
  }
  .area-studies .study-link:hover {
    text-decoration: underline;
  }
  .home-team {
    padding-block: 3.5rem;
    border-block-start: 1px solid var(--line);
  }
  .home-team h2 {
    margin-block-end: 0.6rem;
  }
  .home-team p {
    color: var(--muted);
    max-inline-size: 59ch;
    font-size: 0.9rem;
  }
  :global([dir='rtl']) .research-list h3 span {
    transform: scaleX(-1);
  }
  @media (max-width: 950px) {
    .home-intro {
      gap: 2rem;
      padding-block-start: 3rem;
    }
    .intro-actions {
      gap: 0.75rem 1.25rem;
    }
    .research-layout {
      gap: 3rem;
    }
  }
  @media (max-width: 650px) {
    .home-intro {
      grid-template-columns: 1fr;
      padding-block-start: 2rem;
    }
    h1 {
      font-size: clamp(2.8rem, 12vw, 3.7rem);
    }
    .group-byline {
      margin-block-end: 1.25rem;
    }
    .intro-text {
      font-size: 1rem;
    }
    .intro-actions {
      margin-block-end: 0;
    }
    .intro-visual {
      max-inline-size: 410px;
      inline-size: 100%;
      margin-inline: auto;
      padding-block-start: 0.5rem;
    }
    .institution-links {
      padding-block-start: 0.5rem;
    }
    .research-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .research-section {
      padding-block: 2.75rem;
    }
    .research-list article:first-child {
      border-block-start: 1px solid var(--line-strong);
      padding-block-start: 1.3rem;
    }
  }
</style>
