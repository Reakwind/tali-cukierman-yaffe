---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeroGraphic from './HeroGraphic.astro';
import ResearchScene from './ResearchScene.astro';
import DiabetesIcon from './DiabetesIcon.astro';
import VisualStudy from './VisualStudy.astro';
import VisualMethods from './VisualMethods.astro';
import VisualFooter from './VisualFooter.astro';
import ParticipationInvite from './ParticipationInvite.astro';
import ScrollExperience from './ScrollExperience.astro';
import { ui, type Locale } from '../i18n/ui';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const he = locale === 'he';
const t = ui[locale];
const studies = (await getCollection('studies')).filter(
  (study) => study.data.recruitment,
);
const visuals = await getCollection('visualStudies');
const visualById = new Map(visuals.map((visual) => [visual.id, visual]));
const methods = visuals.find((visual) => visual.data.kind === 'methods')!;
const topics = he
  ? [
      {
        id: 'cognition',
        title: 'סוכרת וקוגניציה',
        text: 'חשיבה, זיכרון ומהירות עיבוד — והדרכים למדוד אותם בגיל המבוגר.',
      },
      {
        id: 'movement',
        title: 'כוח ותפקוד גופני',
        text: 'כושר, כוח ושיווי משקל. הערכה תפקודית, פעילות גופנית ותזונה.',
      },
      {
        id: 'technology',
        title: 'טכנולוגיות סוכרת',
        text: 'מתן אינסולין אוטומטי וכלים דיגיטליים להערכה קוגניטיבית וגופנית.',
      },
    ]
  : [
      {
        id: 'cognition',
        title: 'Diabetes & cognition',
        text: 'Thinking, memory and processing speed — and how to measure them in older age.',
      },
      {
        id: 'movement',
        title: 'Strength & physical function',
        text: 'Fitness, strength and balance. Functional assessment, exercise and nutrition.',
      },
      {
        id: 'technology',
        title: 'Diabetes technology',
        text: 'Automated insulin delivery and digital tools for cognitive and physical assessment.',
      },
    ];
const steps = he
  ? [
      { icon: 'phone' as const, text: 'משאירים פרטי קשר' },
      { icon: 'conversation' as const, text: 'משוחחים עם הצוות' },
      { icon: 'paper' as const, text: 'מכירים את המחקרים' },
    ]
  : [
      { icon: 'phone' as const, text: 'Leave your contact' },
      { icon: 'conversation' as const, text: 'Talk with the team' },
      { icon: 'paper' as const, text: 'Learn about the studies' },
    ];
---

<Layout
  locale={locale}
  title={he ? 'סוכרת, קוגניציה והזדקנות' : 'Diabetes, cognition & aging'}
>
  <section
    class="home-intro parallax-scene"
    data-content-part="hero"
    aria-labelledby="home-title"
  >
    <div class="container hero-pin">
      <div class="intro-copy">
        <p class="group-byline">
          {t.fullName}
          <span>
            {he ? 'שיבא · אוניברסיטת תל אביב' : 'Sheba · Tel Aviv University'}
          </span>
        </p>
        <h1 id="home-title">
          {he ? (
            <>
              <span>סוכרת,</span>
              <span>קוגניציה</span>
              <span>והזדקנות.</span>
            </>
          ) : (
            <>
              <span>Diabetes,</span>
              <span>cognition</span>
              <span>& aging.</span>
            </>
          )}
        </h1>
        <p class="intro-text">
          {he
            ? 'אנו חוקרים חשיבה, תנועה ואיזון סוכר במבוגרים עם סוכרת.'
            : 'We study thinking, movement and glucose management in older adults with diabetes.'}
        </p>
      </div>
      <div class="hero-art" data-hero-visual data-visual>
        <HeroGraphic locale={locale} />
      </div>
    </div>
  </section>
  <section
    id="home-research"
    class="research-section"
    data-content-part="research"
    data-scroll-section
    tabindex="-1"
    aria-labelledby="research-title"
  >
    <div class="container">
      <h2 id="research-title">{he ? 'תחומי המחקר' : 'Research areas'}</h2>
      <div class="research-story parallax-scene">
        <div class="research-visual" data-visual>
          <ResearchScene locale={locale} />
        </div>
        <div class="research-steps">
          {topics.map((topic) => (
            <article
              class="research-step"
              data-research-step={topic.id}
              id={`research-${topic.id}`}
              aria-labelledby={`research-${topic.id}-title`}
            >
              <h3 id={`research-${topic.id}-title`}>{topic.title}</h3>
              <p>{topic.text}</p>
            </article>
          ))}
        </div>
      </div>
      <VisualMethods visual={methods} locale={locale} />
    </div>
  </section>
  <section
    id="home-studies"
    class="studies-section"
    data-content-part="studies"
    data-scroll-section
    tabindex="-1"
    aria-labelledby="home-studies-title"
  >
    <div class="container">
      <header class="section-lead">
        <h2 id="home-studies-title">
          {he ? 'המחקרים שלנו' : 'Current studies'}
        </h2>
        <p>
          {he
            ? 'מחקרי BIRAX ו־STAY-STRONG מגייסים משתתפים. הצוות בודק התאמה להשתתפות.'
            : 'BIRAX and STAY-STRONG are recruiting. The team confirms study suitability.'}
        </p>
      </header>
      {studies.map((study) => (
        <VisualStudy
          study={study}
          visual={visualById.get(study.id)!}
          locale={locale}
        />
      ))}
      <section
        id="home-clinicians"
        class="clinician-route parallax-scene"
        data-scroll-section
        tabindex="-1"
        aria-labelledby="home-clinicians-title"
      >
        <h3 id="home-clinicians-title">
          {he ? 'לצוותים רפואיים' : 'For clinicians'}
        </h3>
        <div class="referral-stage">
          <div
            class="referral-plate-far parallax-layer layer-far"
            data-parallax-layer="far"
            aria-hidden="true"
          ></div>
          <div
            class="referral-plate-mid parallax-layer layer-middle"
            data-parallax-layer="middle"
            aria-hidden="true"
          ></div>
          <div
            class="referral-flow parallax-layer layer-near"
            data-parallax-layer="near"
          >
            <div class="referral-item">
              <DiabetesIcon name="paper" size={100} />
              <p>{he ? 'משתפים מידע על המחקר' : 'Share study information'}</p>
            </div>
            <span aria-hidden="true">→</span>
            <div class="referral-item">
              <DiabetesIcon name="contact" size={100} />
              <p>
                {he ? 'המטופל פונה לצוות' : 'The patient contacts the team'}
              </p>
            </div>
            <span aria-hidden="true">→</span>
            <div class="referral-item">
              <DiabetesIcon name="conversation" size={100} />
              <p>
                {he ? 'הצוות בודק התאמה' : 'The team discusses suitability'}
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>
  <section
    id="home-contact"
    class="contact-section parallax-scene"
    data-content-part="participation"
    data-scroll-section
    tabindex="-1"
    aria-labelledby="home-contact-title"
  >
    <div class="container contact-layout">
      <div class="contact-story">
        <h2 id="home-contact-title">{t.takePart}</h2>
        <div class="contact-stage">
          <div
            class="contact-plate-far parallax-layer layer-far"
            data-parallax-layer="far"
            aria-hidden="true"
          ></div>
          <div
            class="contact-plate-mid parallax-layer layer-middle"
            data-parallax-layer="middle"
            aria-hidden="true"
          ></div>
          <div
            class="contact-steps parallax-layer layer-near"
            data-parallax-layer="near"
          >
            {steps.map((step) => (
              <figure>
                <DiabetesIcon name={step.icon} size={140} />
                <figcaption>{step.text}</figcaption>
              </figure>
            ))}
          </div>
        </div>
        <p>
          {he
            ? 'הצוות יחזור אליכם ויספר עוד על המחקרים.'
            : 'Our team will get in touch to tell you more.'}
        </p>
      </div>
      <ParticipationInvite locale={locale} embedded />
    </div>
    <p class="container professional-contact">
      {he
        ? 'לשיתופי פעולה קליניים או מחקריים:'
        : 'For clinical or research collaboration:'}{' '}
      <a href="mailto:tcukierm@gmail.com">
        {he ? 'כתבו לפרופ׳ צוקרמן־יפה' : 'Email Prof. Cukierman-Yaffe'}
      </a>
    </p>
  </section>
  <VisualFooter slot="footer-content" locale={locale} />
  <ScrollExperience />
</Layout>
<style>
  .home-intro {
    min-block-size: 165svh;
    background: var(--paper);
    position: relative;
  }
  .hero-pin {
    display: grid;
    grid-template-columns: minmax(0, 0.35fr) minmax(0, 0.65fr);
    gap: 2rem;
    align-items: center;
    position: sticky;
    inset-block-start: var(--header-clearance);
    block-size: calc(100svh - var(--header-clearance));
    overflow: clip;
  }
  .intro-copy {
    z-index: 2;
    padding-block: 1rem;
  }
  .group-byline {
    font-size: 0.8rem;
    font-weight: 500;
    margin-block-end: 1.5rem;
  }
  .group-byline span {
    display: block;
    color: var(--muted);
    font-size: 0.75rem;
    margin-block-start: 0.3rem;
  }
  h1 {
    font-size: clamp(2.6rem, 4.8vw, 4.4rem);
    line-height: 1.07;
    letter-spacing: -0.05em;
    margin-block-end: 1.5rem;
  }
  h1 span {
    display: block;
  }
  .intro-text {
    max-inline-size: 29ch;
    font-size: 1rem;
    margin: 0;
  }
  .hero-art {
    inline-size: 100%;
    min-inline-size: 0;
  }
  .research-section {
    padding-block: 4rem;
    border-block-start: 1px solid var(--line);
    background: var(--paper);
  }
  .research-section h2,
  .section-lead h2,
  .contact-story h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .research-section > .container > h2 {
    margin-block-end: 1.25rem;
  }
  .research-story {
    display: grid;
    grid-template-columns: minmax(0, 0.64fr) minmax(0, 0.36fr);
    gap: 2.5rem;
    align-items: start;
  }
  .research-visual {
    position: sticky;
    inset-block-start: var(--header-clearance);
    overflow: clip;
  }
  .research-steps {
    padding-block-end: 12svh;
  }
  .research-step {
    min-block-size: 60svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .research-step h3 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--magenta);
    margin-block-end: 1rem;
  }
  .research-step p {
    font-size: 1rem;
    max-inline-size: 28ch;
  }
  .studies-section {
    padding-block: 4rem;
    background: var(--paper);
  }
  .section-lead {
    margin-block-end: 2rem;
    max-inline-size: 65ch;
  }
  .section-lead p {
    color: var(--muted);
  }
  .clinician-route {
    margin-block-start: 3rem;
    padding: 2.25rem;
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .referral-stage {
    position: relative;
    padding: 1.75rem;
    margin-block-start: 1rem;
  }
  .referral-plate-far {
    position: absolute;
    inset: 0.25rem 0;
    border-radius: 18px;
    background: var(--teal-paper);
    z-index: 0;
  }
  .referral-plate-mid {
    position: absolute;
    inset: 0.75rem 1rem;
    border-radius: 14px;
    border: 1.5px dashed var(--line-strong);
    z-index: 1;
  }
  .referral-flow {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .referral-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex: 1 1 0;
    padding: 0.75rem 1rem;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
  }
  .referral-flow p {
    font-size: 0.85rem;
    margin: 0;
  }
  .referral-flow :global(svg) {
    flex: 0 0 70px;
  }
  .contact-section {
    padding-block: 4rem 2rem;
    border-block-start: 1px solid var(--line);
    background: var(--paper);
  }
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 0.4fr);
    gap: 3rem;
    align-items: center;
  }
  .contact-stage {
    position: relative;
    padding: 2rem 1.5rem;
    margin-block: 1.5rem;
  }
  .contact-plate-far {
    position: absolute;
    inset: 0.35rem 0;
    border-radius: 20px;
    background: var(--teal-paper);
    z-index: 0;
  }
  .contact-plate-mid {
    position: absolute;
    inset: 0.85rem 1rem;
    border-radius: 16px;
    border: 1.5px dashed var(--line-strong);
    z-index: 1;
  }
  .contact-steps {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .contact-steps figure {
    margin: 0;
    flex: 1 1 0;
    min-inline-size: 0;
    text-align: center;
    max-inline-size: 165px;
    padding: 0.85rem 0.5rem;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
  }
  .contact-steps figcaption {
    font-size: 0.8rem;
    margin-block-start: 0.75rem;
  }
  .contact-story > p {
    font-size: 0.9rem;
  }
  .professional-contact {
    font-size: 0.85rem;
    margin-block-start: 2rem;
  }
  @media (max-width: 1099px) {
    .referral-flow {
      flex-wrap: wrap;
    }
    .contact-layout {
      gap: 1.5rem;
      grid-template-columns: 1fr 1fr;
    }
    .contact-steps :global(svg) {
      inline-size: 90px;
      block-size: 90px;
    }
  }
  @media (max-width: 650px) {
    .home-intro {
      min-block-size: 160svh;
    }
    .hero-pin {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      gap: 0.5rem;
      align-content: start;
    }
    .intro-copy {
      padding-block: 0.5rem 0;
    }
    .group-byline {
      margin-block-end: 0.7rem;
      font-size: 0.75rem;
    }
    .group-byline span {
      font-size: 0.7rem;
    }
    h1 {
      font-size: clamp(2.2rem, 10vw, 3rem);
      margin-block-end: 0.7rem;
      line-height: 1.02;
    }
    .intro-text {
      font-size: 0.9rem;
      max-inline-size: 34ch;
    }
    .hero-art {
      inline-size: calc(100% + 2rem);
      margin-inline: -1rem;
      max-inline-size: none;
      align-self: center;
    }
    .research-section,
    .studies-section,
    .contact-section {
      padding-block: 2.5rem;
    }
    .research-story {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .research-visual {
      position: relative;
      inset-block-start: auto;
      max-inline-size: 420px;
    }
    .research-steps {
      padding-block-end: 0;
    }
    .research-step {
      min-block-size: 0;
      padding-block: 1.25rem;
    }
    .research-step p {
      max-inline-size: 40ch;
    }
    .contact-layout {
      grid-template-columns: 1fr;
    }
    .referral-stage,
    .contact-stage {
      padding: 0.75rem;
    }
    .referral-flow {
      display: grid;
      grid-template-columns: 1fr;
    }
    .referral-flow > span {
      display: none;
    }
    .clinician-route {
      padding: 1.25rem;
    }
    .contact-steps {
      gap: 0.5rem;
    }
  }
  @media (max-width: 650px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    .research-story {
      --research-scene-height: min(40svh, 340px);
    }
    .research-visual {
      grid-area: 1 / 1;
      position: sticky;
      inset-block-start: var(--header-clearance);
      block-size: var(--research-scene-height);
      inline-size: 100%;
      z-index: 2;
      background: var(--paper);
    }
    .research-visual :global(.research-scene) {
      block-size: 100%;
    }
    .research-steps {
      grid-area: 1 / 1;
      padding-block-start: calc(var(--research-scene-height) + 2rem);
    }
    .research-step {
      min-block-size: 60svh;
      padding-block: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-intro {
      min-block-size: 0;
    }
    .hero-pin {
      position: relative;
      inset-block-start: auto;
      block-size: auto;
      padding-block: 2rem;
    }
    .research-steps {
      padding-block-end: 0;
    }
    .research-step {
      min-block-size: 0;
      padding-block: 2rem;
    }
    .research-visual {
      position: relative;
      inset-block-start: auto;
    }
  }
</style>
