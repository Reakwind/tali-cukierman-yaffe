---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';
import DiabetesIcon from './DiabetesIcon.astro';
interface Props {
  visual: CollectionEntry<'visualStudies'>;
  locale: Locale;
}
const { visual, locale } = Astro.props;
const data = visual.data;
if (data.kind !== 'result')
  throw new Error('A research result needs its sourced result record.');
const copy = data.localized[locale];
const he = locale === 'he';
---

<article
  id="study-hybrid-closed-loop"
  class="visual-result"
  data-study="hybrid-closed-loop"
  tabindex="-1"
  aria-labelledby="grace-result-title"
>
  <div class="result-art">
    <DiabetesIcon name="pump" size={210} />
    <DiabetesIcon name="sensor" size={135} />
  </div>
  <div class="result-evidence">
    <p class="result-type">{copy.visitNote}</p>
    <h3 id="grace-result-title">
      <bdi dir="ltr">GRACE-780G</bdi>
    </h3>
    <p>{copy.audience}</p>
    <h4>{copy.metric}</h4>
    <p class="target-range">
      <bdi dir="ltr">
        {data.targetRange[0]}–{data.targetRange[1]} mg/dL
      </bdi>
    </p>
    <div class="result-measure">
      <label for="grace-automated">{copy.automated}</label>
      <strong>
        <bdi>{data.timeInRange.automated.toFixed(1)}%</bdi>
      </strong>
      <meter
        id="grace-automated"
        min="0"
        max="100"
        value={data.timeInRange.automated}
      >
        {data.timeInRange.automated}%
      </meter>
    </div>
    <div class="result-measure result-measure--standard">
      <label for="grace-standard">{copy.standard}</label>
      <strong>
        <bdi>{data.timeInRange.standard.toFixed(1)}%</bdi>
      </strong>
      <meter
        id="grace-standard"
        min="0"
        max="100"
        value={data.timeInRange.standard}
      >
        {data.timeInRange.standard}%
      </meter>
    </div>
    <p class="result-sample">
      <DiabetesIcon name="contact" size={42} />
      <span>
        <bdi>{data.participants}</bdi> {he ? 'משתתפים' : 'participants'}
      </span>
      <DiabetesIcon name="calendar" size={42} />
      <span>
        <bdi>{data.followupMonths}</bdi> {he ? 'חודשים' : 'months'}
      </span>
    </p>
  </div>
</article>
<style>
  .visual-result {
    display: grid;
    grid-template-columns: 0.6fr 0.4fr;
    gap: 3rem;
    align-items: center;
    padding: 3rem;
    background: var(--paper);
    border-block-start: 3px solid var(--magenta);
  }
  .result-art {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .result-art :global(svg:first-child) {
    inline-size: 60%;
    block-size: auto;
  }
  .result-art :global(svg:last-child) {
    inline-size: 36%;
    block-size: auto;
  }
  .result-type,
  .target-range {
    font-size: 0.75rem;
    color: var(--muted);
  }
  h3 {
    font-size: 2rem;
    margin-block: 0.5rem;
  }
  h4 {
    font-size: 1rem;
    margin-block: 1.5rem 0.3rem;
  }
  .result-evidence > p {
    font-size: 0.85rem;
  }
  .result-measure {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1rem;
    margin-block: 1rem;
  }
  label {
    font-size: 0.85rem;
  }
  strong {
    color: var(--teal);
  }
  .result-measure--standard strong {
    color: var(--magenta);
  }
  meter {
    grid-column: 1 / -1;
    inline-size: 100%;
    block-size: 28px;
    border: none;
    background: var(--teal-soft);
    border-radius: 0;
    direction: ltr;
  }
  meter::-webkit-meter-bar {
    background: var(--teal-soft);
    border: none;
    border-radius: 0;
  }
  meter::-webkit-meter-optimum-value {
    background: var(--teal);
    border-radius: 0;
  }
  meter::-moz-meter-bar {
    background: var(--teal);
  }
  .result-measure--standard meter {
    background: var(--magenta-soft);
  }
  .result-measure--standard meter::-webkit-meter-bar {
    background: var(--magenta-soft);
  }
  .result-measure--standard meter::-webkit-meter-optimum-value {
    background: var(--magenta);
  }
  .result-measure--standard meter::-moz-meter-bar {
    background: var(--magenta);
  }
  .result-sample {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1.5rem 0;
  }
  @media (max-width: 950px) {
    .visual-result {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.5rem;
    }
    .result-art {
      max-inline-size: 400px;
      margin-inline: auto;
    }
  }
</style>
