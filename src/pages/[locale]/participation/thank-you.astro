---
import Layout from '../../../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, type Locale } from '../../../i18n/ui';
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const he = locale === 'he';
---

<Layout
  locale={locale}
  title={he ? 'תודה על הפנייה' : 'Thank you for getting in touch'}
  description={
    he
      ? 'פרטי הקשר שלכם נשלחו לצוות המחקר.'
      : 'Your contact details have been sent to the research team.'
  }
  pagePath="participation/thank-you/"
>
  <div class="container article-page">
    <div class="page-heading">
      <h1>{he ? 'תודה על הפנייה' : 'Thank you for getting in touch'}</h1>
      <p class="page-intro">
        {he
          ? 'פרטי הקשר שלכם נשלחו לצוות המחקר.'
          : 'Your contact details have been sent to the research team.'}
      </p>
      <a class="text-link" href={getRelativeLocaleUrl(locale)}>
        {he ? 'בחזרה לאתר' : 'Back to the website'}
      </a>
    </div>
  </div>
</Layout>
