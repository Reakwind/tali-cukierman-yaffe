---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import { locales, ui, type Locale } from '../../i18n/ui';
import { pages, pageKeys, type PageKey } from '../../data/pages';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    pageKeys.map((page) => ({
      params: { locale, page },
      props: { locale, page },
    })),
  );
}
interface Props {
  locale: Locale;
  page: PageKey;
}
const { locale, page } = Astro.props;
const content = pages[locale][page];
const t = ui[locale];
---

<Layout
  locale={locale}
  title={content.title}
  description={content.intro}
  pagePath={page}
>
  <div class="container">
    <nav
      class="breadcrumbs"
      aria-label={locale === 'he' ? 'מיקום באתר' : 'Breadcrumb'}
    >
      <a href={getRelativeLocaleUrl(locale)}>{t.home}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{content.title}</span>
    </nav>
    <div class="page-heading">
      <p class="eyebrow">{t.groupName}</p>
      <h1>{content.title}</h1>
      <p class="page-intro">{content.intro}</p>
    </div>
    <div class="article-wrap">
      {content.sections.map((section) => (
        <section
          class="article-section"
          id={section.id}
          aria-labelledby={`${section.id}-title`}
        >
          <h2 id={`${section.id}-title`}>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
        </section>
      ))}
      {content.sources && (
        <section
          class="article-section sources"
          aria-labelledby="sources-title"
        >
          <h2 id="sources-title">{t.sources}</h2>
          <ul>
            {content.sources.map((source) => (
              <li>
                <a href={source.url}>{source.label}</a>
              </li>
            ))}
          </ul>
          <p class="small">{t.copyNote}</p>
        </section>
      )}
      {['research', 'for-clinicians', 'participation'].includes(page) && (
        <div class="actions">
          <a class="button" href={getRelativeLocaleUrl(locale, 'studies/')}>
            {t.explore}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
          {page === 'research' && (
            <a
              class="text-link"
              href={getRelativeLocaleUrl(locale, 'publications/')}
            >
              {t.publications}
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</Layout>
