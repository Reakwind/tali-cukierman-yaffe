---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import TeamProfiles from '../../components/TeamProfiles.astro';
import PublicationList from '../../components/PublicationList.astro';
import ResearchText from '../../components/ResearchText.astro';
import ParticipationInvite from '../../components/ParticipationInvite.astro';
import { locales, ui, type Locale } from '../../i18n/ui';
import { pages, pageKeys, type PageKey } from '../../data/pages';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    pageKeys
      .filter((page) => page !== 'studies')
      .map((page) => ({
        params: { locale, page },
        props: { locale, page },
      })),
  );
}
interface Props {
  locale: Locale;
  page: PageKey;
}
const { locale, page } = Astro.props;
const content = pages[locale][page];
const t = ui[locale];
---

<Layout
  locale={locale}
  title={content.title}
  description={content.intro}
  pagePath={page}
>
  <div class="container article-page">
    <nav
      class="breadcrumbs"
      aria-label={locale === 'he' ? 'מיקום באתר' : 'Breadcrumb'}
    >
      <a href={getRelativeLocaleUrl(locale)}>{t.home}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{content.title}</span>
    </nav>
    <div class="page-heading">
      <h1>{content.title}</h1>
      <p class="page-intro">{content.intro}</p>
    </div>
    <div class="article-wrap">
      {page === 'participation' && <ParticipationInvite locale={locale} />}
      {page === 'publications' && <PublicationList locale={locale} />}
      {content.sections.map((section) => (
        <section
          class="article-section"
          id={section.id}
          aria-labelledby={`${section.id}-title`}
        >
          <h2 id={`${section.id}-title`}>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>
              <ResearchText text={paragraph} />
            </p>
          ))}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
          {section.links && (
            <div class="section-links">
              {section.links.map((link) => (
                <a
                  class="text-link"
                  href={getRelativeLocaleUrl(locale, link.path)}
                >
                  {link.label}
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              ))}
            </div>
          )}
          {page === 'about' && section.id === 'people' && (
            <TeamProfiles locale={locale} />
          )}
          {((page === 'research' && section.id === 'collaboration') ||
            (page === 'for-clinicians' && section.id === 'partners')) && (
            <a class="button" href="mailto:tcukierm@gmail.com">
              {locale === 'he'
                ? 'ליצירת קשר עם טלי'
                : 'Email Tali about collaboration'}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          )}
        </section>
      ))}
      {content.sources && (
        <section
          class="article-section sources"
          aria-labelledby="sources-title"
        >
          <h2 id="sources-title">{t.sources}</h2>
          <ul>
            {content.sources.map((source) => (
              <li>
                <a href={source.url}>{source.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {page === 'research' && (
        <div class="actions">
          <a
            class="text-link"
            href={getRelativeLocaleUrl(locale, 'publications/')}
          >
            {t.publications}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      )}
      {page === 'for-clinicians' && (
        <div class="actions">
          <a class="button" href={getRelativeLocaleUrl(locale, 'studies/')}>
            {t.explore}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      )}
    </div>
  </div>
</Layout>
