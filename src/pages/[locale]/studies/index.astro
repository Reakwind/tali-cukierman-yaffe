---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../../layouts/Layout.astro';
import StudyCard from '../../../components/StudyCard.astro';
import { locales, ui, type Locale } from '../../../i18n/ui';
import { pages } from '../../../data/pages';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const content = pages[locale].studies;
const studies = (await getCollection('studies')).sort(
  (a, b) =>
    Number(b.data.registryStatus === 'RECRUITING') -
    Number(a.data.registryStatus === 'RECRUITING'),
);
---

<Layout
  locale={locale}
  title={t.nav.studies}
  description={content.intro}
  pagePath="studies"
>
  <div class="container">
    <nav
      class="breadcrumbs"
      aria-label={locale === 'he' ? 'מיקום באתר' : 'Breadcrumb'}
    >
      <a href={getRelativeLocaleUrl(locale)}>{t.home}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{t.nav.studies}</span>
    </nav>
    <div class="page-heading">
      <h1>{content.title}</h1>
      <p class="page-intro">{content.intro}</p>
    </div>
    <div class="study-grid">
      {studies.map((study) => (
        <StudyCard study={study} locale={locale} />
      ))}
    </div>
    <div class="notice article-wrap">
      <p class="small">{t.enquiryExplanation}</p>
      <a
        class="text-link"
        href={getRelativeLocaleUrl(locale, 'participation/')}
      >
        {t.participation}
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
    </div>
  </div>
</Layout>
