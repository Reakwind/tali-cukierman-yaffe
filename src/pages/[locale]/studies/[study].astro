---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../../layouts/Layout.astro';
import StudyName from '../../../components/StudyName.astro';
import { locales, ui, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const studies = await getCollection('studies');
  return locales.flatMap((locale) =>
    studies.map((study) => ({
      params: { locale, study: study.id },
      props: { locale, study },
    })),
  );
}
interface Props {
  locale: Locale;
  study: CollectionEntry<'studies'>;
}
const { locale, study } = Astro.props;
const t = ui[locale];
const data = study.data;
const content = data.localized[locale];
const closed = data.registryStatus === 'COMPLETED';
const date = (value: string) =>
  new Intl.DateTimeFormat(locale === 'he' ? 'he-IL' : 'en-GB', {
    dateStyle: 'long',
    timeZone: 'UTC',
  }).format(new Date(`${value}T00:00:00Z`));
---

<Layout
  locale={locale}
  title={content.title}
  description={content.summary}
  pagePath={`studies/${study.id}/`}
>
  <div class="container">
    <nav
      class="breadcrumbs"
      aria-label={locale === 'he' ? 'מיקום באתר' : 'Breadcrumb'}
    >
      <a href={getRelativeLocaleUrl(locale)}>{t.home}</a>
      <span aria-hidden="true">/</span>
      <a href={getRelativeLocaleUrl(locale, 'studies/')}>{t.nav.studies}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{content.title}</span>
    </nav>
    <div class="page-heading">
      <p class="eyebrow">
        {t.record} · <bdi dir="ltr">{data.registryId}</bdi>
      </p>
      <span class:list={['status', { 'status-closed': closed }]}>
        {closed ? t.completed : t.recruiting}
      </span>
      <h1 class="study-detail-title">
        <StudyName title={content.title} acronym={data.acronym} />
      </h1>
      <p class="page-intro">{content.summary}</p>
      <p class="small muted">
        {t.updated}:{' '}
        <time datetime={data.registryUpdated}>
          {date(data.registryUpdated)}
        </time>
        <br />
        {t.checked}:{' '}
        <time datetime={data.sourceChecked}>{date(data.sourceChecked)}</time>
      </p>
    </div>
    <div class="article-wrap">
      <section
        class="notice"
        data-enquiry-state
        aria-labelledby="enquiry-heading"
      >
        <h2 id="enquiry-heading" class="notice-heading">
          {closed ? t.enquiryClosed : t.enquiryPending}
        </h2>
        {!closed && <p>{t.enquiryExplanation}</p>}
        {!closed && (
          <div data-consider>
            <h3 class="notice-heading">{t.considerTitle}</h3>
            <ul>
              {t.consider.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
        <a class="text-link" href={data.registryUrl}>
          {t.registryLink}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </section>
      <section class="article-section" aria-labelledby="population-heading">
        <h2 id="population-heading">{t.population}</h2>
        <p>{content.population}</p>
      </section>
      <section class="article-section" aria-labelledby="location-heading">
        <h2 id="location-heading">{t.location}</h2>
        <p>{content.location}</p>
      </section>
      <section class="article-section" aria-labelledby="duration-heading">
        <h2 id="duration-heading">{t.duration}</h2>
        <p>{content.duration}</p>
      </section>
      <section class="article-section" aria-labelledby="involves-heading">
        <h2 id="involves-heading">{t.involves}</h2>
        <ul>
          {content.activities.map((activity) => (
            <li>{activity}</li>
          ))}
        </ul>
      </section>
      <section class="article-section" aria-labelledby="important-heading">
        <h2 id="important-heading">
          {locale === 'he' ? 'לפני שמחליטים' : 'Before making a decision'}
        </h2>
        <p>{content.caution}</p>
        <a
          class="text-link"
          href={getRelativeLocaleUrl(locale, 'participation/')}
        >
          {t.participation}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </section>
      <a class="text-link" href={getRelativeLocaleUrl(locale, 'studies/')}>
        {t.back}
      </a>
    </div>
  </div>
</Layout>
