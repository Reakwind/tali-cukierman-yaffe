---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../../layouts/Layout.astro';
import StudyName from '../../../components/StudyName.astro';
import ResearchText from '../../../components/ResearchText.astro';
import PublicationList from '../../../components/PublicationList.astro';
import ParticipationInvite from '../../../components/ParticipationInvite.astro';
import { locales, ui, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const studies = await getCollection('studies');
  return locales.flatMap((locale) =>
    studies.map((study) => ({
      params: { locale, study: study.id },
      props: { locale, study },
    })),
  );
}
interface Props {
  locale: Locale;
  study: CollectionEntry<'studies'>;
}
const { locale, study } = Astro.props;
const t = ui[locale];
const data = study.data;
const content = data.localized[locale];
const closed = data.registryStatus === 'COMPLETED';
const recruiting = Boolean(data.recruitment);
const project = data.kind === 'project';
const date = (value: string) =>
  new Intl.DateTimeFormat(locale === 'he' ? 'he-IL' : 'en-GB', {
    dateStyle: 'long',
    timeZone: 'UTC',
  }).format(new Date(`${value}T00:00:00Z`));
---

<Layout
  locale={locale}
  title={content.title}
  description={content.summary}
  pagePath={`studies/${study.id}/`}
>
  <div class="container">
    <nav
      class="breadcrumbs"
      aria-label={locale === 'he' ? 'מיקום באתר' : 'Breadcrumb'}
    >
      <a href={getRelativeLocaleUrl(locale)}>{t.home}</a>
      <span aria-hidden="true">/</span>
      <a href={getRelativeLocaleUrl(locale, 'studies/')}>{t.nav.studies}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{content.title}</span>
    </nav>
    <div class="page-heading">
      <p class="eyebrow">
        {data.kind === 'trial' ? (
          <>
            {t.record} · <bdi dir="ltr">{data.registryId}</bdi>
          </>
        ) : (
          t.project
        )}
      </p>
      {recruiting && <span class="status">{t.recruiting}</span>}
      <h1 class="study-detail-title">
        <StudyName title={content.title} acronym={data.acronym} />
      </h1>
      <p class="page-intro">
        <ResearchText text={content.summary} />
      </p>
      <p class="small muted">
        {data.kind === 'trial' && (
          <>
            {t.updated}:{' '}
            <time datetime={data.registryUpdated}>
              {date(data.registryUpdated)}
            </time>{' '}
            ·{' '}
          </>
        )}
        {t.sourceChecked}:{' '}
        <time datetime={data.sourceChecked}>{date(data.sourceChecked)}</time>
      </p>
    </div>
    <div class="article-wrap">
      {recruiting && <ParticipationInvite locale={locale} studyId={study.id} />}
      <section class="article-section" aria-labelledby="population-heading">
        <h2 id="population-heading">
          {closed
            ? t.completedPopulation
            : project
              ? t.projectPopulation
              : t.population}
        </h2>
        <p>
          <ResearchText text={content.population} />
        </p>
      </section>
      <section class="article-section" aria-labelledby="location-heading">
        <h2 id="location-heading">
          {closed
            ? t.completedLocation
            : project
              ? t.projectLocation
              : t.location}
        </h2>
        <p>
          <ResearchText text={content.location} />
        </p>
      </section>
      <section class="article-section" aria-labelledby="duration-heading">
        <h2 id="duration-heading">
          {closed
            ? t.completedDuration
            : project
              ? t.projectDuration
              : t.duration}
        </h2>
        <p>
          <ResearchText text={content.duration} />
        </p>
      </section>
      <section class="article-section" aria-labelledby="involves-heading">
        <h2 id="involves-heading">
          {closed
            ? t.completedInvolves
            : project
              ? t.projectInvolves
              : t.involves}
        </h2>
        <ul>
          {content.activities.map((activity) => (
            <li>
              <ResearchText text={activity} />
            </li>
          ))}
        </ul>
        {recruiting && (
          <a
            class="text-link"
            href={getRelativeLocaleUrl(locale, 'participation/')}
          >
            {t.participation}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        )}
      </section>
      {closed && (
        <section class="article-section" aria-labelledby="important-heading">
          <h2 id="important-heading">
            {closed
              ? locale === 'he'
                ? 'כיצד לקרוא את הממצאים'
                : 'Interpreting the findings'
              : locale === 'he'
                ? 'לפני שמחליטים'
                : 'Before making a decision'}
          </h2>
          <p>
            <ResearchText text={content.caution} />
          </p>
        </section>
      )}
      <div class="article-section">
        <a
          class="text-link"
          href={data.kind === 'trial' ? data.registryUrl : data.sourceUrl}
        >
          {project ? t.projectLink : t.registryLink}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
      <section class="article-section" aria-labelledby="research-heading">
        <h2 id="research-heading">{t.researchDetails}</h2>
        {content.research.map((paragraph) => (
          <p>
            <ResearchText text={paragraph} />
          </p>
        ))}
      </section>
      <section
        id="outputs"
        class="article-section"
        aria-labelledby="outputs-heading"
      >
        <h2 id="outputs-heading">{t.relatedPublications}</h2>
        <PublicationList locale={locale} studyId={study.id} />
      </section>
    </div>
  </div>
</Layout>
