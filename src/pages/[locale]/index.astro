---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import StudyName from '../../components/StudyName.astro';
import { locales, ui, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const he = locale === 'he';
const featured = (await getCollection('studies')).find(
  (study) => study.data.registryStatus === 'RECRUITING',
);
const featuredCopy = featured?.data.localized[locale];
const date = (value: string) =>
  new Intl.DateTimeFormat(he ? 'he-IL' : 'en-GB', {
    dateStyle: 'long',
    timeZone: 'UTC',
  }).format(new Date(`${value}T00:00:00Z`));
const content = he
  ? {
      eyebrow: 'סוכרת · קוגניציה · הזדקנות בריאה',
      title: ['לחיות טוב.', 'להזדקן בבריאות.'],
      intro:
        'חוקרים את הקשרים בין סוכרת, בריאות המוח ותפקוד גופני — יחד עם האנשים שהמחקר נוגע לחייהם.',
      clinician: 'מידע לצוותים רפואיים',
      note: 'בשלב זה ניתן לקרוא על המחקרים. פנייה להשתתפות תתאפשר לאחר אישור מסלול הפנייה בידי הצוות.',
      panelLabel: 'מדע עם אנשים במרכז',
      panelTitle: 'לראות את האדם. לא רק את הסוכרת.',
      topics: ['חשיבה וזיכרון', 'תנועה ותפקוד', 'איכות חיים'],
      affiliations: 'מחברים בין מחקר לעשייה קלינית',
      focusEyebrow: 'השאלות שמניעות אותנו',
      focusTitle: 'שלוש נקודות מבט. אדם אחד.',
      focusIntro: 'מחקר בין־תחומי שמבקש להבין את הבריאות כחלק מהחיים עצמם.',
      themes: [
        [
          'בריאות קוגניטיבית',
          'להבין את הקשר בין סוכרת לשינויים בחשיבה ובזיכרון לאורך החיים.',
        ],
        [
          'תנועה ועצמאות',
          'לחקור כוח שריר, תפקוד גופני ואת האתגרים של הזדקנות עם סוכרת.',
        ],
        [
          'טכנולוגיה עם תכלית',
          'לפתח ולבחון כלים דיגיטליים להערכה ולתמיכה במחקר ובטיפול.',
        ],
      ],
      studyEyebrow: 'להכיר את המחקרים',
      studyTitle: 'השאלה הבאה מתחילה כאן.',
      allStudies: 'לכל המחקרים',
      studyLink: 'לקריאה על המחקר',
      studyNote:
        'זהו סיכום טיוטה ממקור ציבורי, לא אישור התאמה או זמינות. פרטי ההשתתפות והפנייה עדיין דורשים אישור של צוות המחקר.',
      groupEyebrow: 'הקבוצה שלנו',
      groupTitle: 'סקרנות מדעית. נקודת מבט אנושית.',
      groupText:
        'בהובלת פרופ׳ טלי צוקרמן־יפה, אנדוקרינולוגית ואפידמיולוגית קלינית, המחקר מחבר בין סוכרת, קוגניציה והזדקנות. העשייה משתרעת על פני מחקר קליני, שיתופי פעולה בין־לאומיים ופיתוח כלים דיגיטליים.',
      groupLink: 'להכיר את הקבוצה',
      paths: [
        [
          'למטופלים ולבני משפחה',
          'סקרנים לגבי השתתפות?',
          'אפשר להתחיל בשאלה. קראו על המחקרים ועל המשמעות של השתתפות, ללא התחייבות.',
          'על השתתפות במחקר',
          'participation/',
        ],
        [
          'לצוותים רפואיים',
          'מחברים מטופלים למחקר.',
          'מידע ראשוני ושיתוף דפי מחקר עם מטופלים — בלי להעביר מידע רפואי באתר.',
          'מידע על הפניות',
          'for-clinicians/',
        ],
        [
          'לחוקרים ולסטודנטים',
          'מקום לשאלות משותפות.',
          'תחומי המחקר, פרסומים נבחרים וקשרים אקדמיים — כדי למצוא נקודת חיבור.',
          'למחקר ולפרסומים',
          'research/',
        ],
      ],
    }
  : {
      eyebrow: 'Diabetes · Cognition · Healthy aging',
      title: ['Aging well.', 'Living fully.'],
      intro:
        'Exploring the connections between diabetes, brain health, and physical function — together with the people it matters to.',
      clinician: 'For clinicians & collaborators',
      note: 'Explore the research now. Participant enquiries will open only after the team approves a secure contact route.',
      panelLabel: 'Science, with people at its heart',
      panelTitle: 'A whole person. Not just a glucose number.',
      topics: ['Mind', 'Movement', 'Quality of life'],
      affiliations: 'Connecting research and clinical practice',
      focusEyebrow: 'The questions that move us',
      focusTitle: 'Three perspectives. One person.',
      focusIntro:
        'Interdisciplinary research grounded in the realities of everyday life.',
      themes: [
        [
          'Cognitive health',
          'Understanding how diabetes relates to changes in thinking and memory across the lifespan.',
        ],
        [
          'Movement & independence',
          'Investigating muscle strength, physical function, and the challenges of aging with diabetes.',
        ],
        [
          'Purposeful technology',
          'Developing and evaluating digital tools for assessment, research, and care.',
        ],
      ],
      studyEyebrow: 'Discover the research',
      studyTitle: 'The next question starts here.',
      allStudies: 'View all studies',
      studyLink: 'Read about the study',
      studyNote:
        'A public-source draft, not eligibility confirmation or a guarantee of availability. Participation information and the enquiry route still require research-team approval.',
      groupEyebrow: 'Meet the group',
      groupTitle: 'Scientific curiosity. A human perspective.',
      groupText:
        'Led by Prof. Tali Cukierman-Yaffe, an endocrinologist and clinical epidemiologist, the research connects diabetes, cognition, and aging. The work spans clinical research, international collaboration, and the development of digital assessment tools.',
      groupLink: 'Get to know the group',
      paths: [
        [
          'For patients & caregivers',
          'Curious about taking part?',
          'Start with a question. Explore our research and what participation involves, without making a commitment.',
          'About participation',
          'participation/',
        ],
        [
          'For clinicians',
          'Connect people with research.',
          'Find initial study information and share it with patients — without sending medical details through this site.',
          'About referrals',
          'for-clinicians/',
        ],
        [
          'For researchers & students',
          'Room for shared questions.',
          'Explore research themes, selected publications, and academic connections to find common ground.',
          'Research & publications',
          'research/',
        ],
      ],
    };
---

<Layout locale={locale} title={t.group}>
  <div class="container hero">
    <div>
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>
        <span>{content.title[0]}</span>
        <span class="soft">{content.title[1]}</span>
      </h1>
      <p class="hero-description">{content.intro}</p>
      <div class="actions">
        <a class="button" href={getRelativeLocaleUrl(locale, 'studies/')}>
          {t.explore}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
        <a
          class="text-link"
          href={getRelativeLocaleUrl(locale, 'for-clinicians/')}
        >
          {content.clinician}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
      <p class="hero-note">{content.note}</p>
    </div>
    <div class="hero-panel">
      <span class="orbit" aria-hidden="true"></span>
      <span class="orbit" aria-hidden="true"></span>
      <p class="panel-label">{content.panelLabel}</p>
      <p class="panel-title">{content.panelTitle}</p>
      <div class="panel-topics">
        {content.topics.map((topic) => (
          <span>{topic}</span>
        ))}
      </div>
    </div>
  </div>
  <div class="affiliations">
    <div class="container affiliations-inner">
      <p class="affiliations-label">{content.affiliations}</p>
      <a href="https://eng.sheba.co.il/Center-for-Treatment-and-Study-Diabetes-in-Old-Age">
        {he ? 'המרכז הרפואי שיבא' : 'Sheba Medical Center'}
      </a>
      <a href="https://cris.tau.ac.il/en/persons/tali-cukierman-yaffe/">
        {he ? 'אוניברסיטת תל אביב' : 'Tel Aviv University'}
      </a>
      <a
        href="https://www.phri.ca/collaborations/phri-international-fellows/"
        lang="en"
        dir="ltr"
      >
        PHRI
      </a>
      <a href="https://6-vital.com/" lang="en" dir="ltr">
        6 Vital
      </a>
    </div>
  </div>
  <section class="container section" aria-labelledby="focus-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{content.focusEyebrow}</p>
        <h2 id="focus-title">{content.focusTitle}</h2>
      </div>
      <p>{content.focusIntro}</p>
    </div>
    <div class="theme-grid">
      {content.themes.map(([title, description], index) => (
        <article class="theme-item">
          <span class="theme-number" aria-hidden="true">
            0{index + 1}
          </span>
          <h3>{title}</h3>
          <p>{description}</p>
          <a
            class="text-link"
            href={`${getRelativeLocaleUrl(locale, 'research/')}#${['cognition', 'movement', 'technology'][index]}`}
          >
            {t.learn}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
            <span class="visually-hidden">: {title}</span>
          </a>
        </article>
      ))}
    </div>
  </section>
  {featured && featuredCopy && (
    <section class="study-section section" aria-labelledby="study-title">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{content.studyEyebrow}</p>
            <h2 id="study-title">{content.studyTitle}</h2>
          </div>
          <a class="text-link" href={getRelativeLocaleUrl(locale, 'studies/')}>
            {content.allStudies}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
        <article class="feature-study">
          <div>
            <span class="status">{t.recruiting}</span>
            <h3>
              <StudyName
                title={featuredCopy.title}
                acronym={featured.data.acronym}
              />
            </h3>
            <p>{featuredCopy.summary}</p>
            <a
              class="text-link"
              href={getRelativeLocaleUrl(locale, `studies/${featured.id}/`)}
            >
              {content.studyLink}
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </div>
          <dl class="study-facts">
            <div>
              <dt>{t.record}</dt>
              <dd>
                <bdi dir="ltr">{featured.data.registryId}</bdi>
              </dd>
            </div>
            <div>
              <dt>{t.duration}</dt>
              <dd>{featuredCopy.duration}</dd>
            </div>
            <div>
              <dt>{t.updated}</dt>
              <dd>
                <time datetime={featured.data.registryUpdated}>
                  {date(featured.data.registryUpdated)}
                </time>
              </dd>
            </div>
          </dl>
        </article>
        <p class="quiet-note">{content.studyNote}</p>
      </div>
    </section>
  )}
  <section class="container section" aria-labelledby="group-title">
    <div class="split-section">
      <div>
        <p class="eyebrow">{content.groupEyebrow}</p>
        <h2 id="group-title">{content.groupTitle}</h2>
      </div>
      <div class="body-copy">
        <p>{content.groupText}</p>
        <a class="text-link" href={getRelativeLocaleUrl(locale, 'about/')}>
          {content.groupLink}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
    </div>
    <div class="path-grid">
      {content.paths.map(([eyebrow, title, text, link, path]) => (
        <article class="path-card">
          <p class="eyebrow">{eyebrow}</p>
          <h3>{title}</h3>
          <p>{text}</p>
          <a class="text-link" href={getRelativeLocaleUrl(locale, path)}>
            {link}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>
