---
import Home from '../../components/Home.astro';
import { locales, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Home locale={locale} />
