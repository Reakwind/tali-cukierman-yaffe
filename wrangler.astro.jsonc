{
  // The earlier Astro draft, kept for its tests; never the published site.
  "name": "tali-cukierman-yaffe-astro",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "run_worker_first": ["/api/*"],
  },
  "vars": { "ENQUIRIES_ENABLED": "false" },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": [
        "reakwind@gmail.com",
        "hagarshimon@gmail.com",
        "yasminshtig@gmail.com",
        "tcukierm@gmail.com",
      ],
    },
  ],
  "observability": { "enabled": false },
}
