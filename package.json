{
  "name": "tali-cukierman-yaffe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "session:start": "node scripts/session.ts start",
    "day:finish": "node scripts/session.ts finish",
    "day:cleanup": "node scripts/session.ts cleanup",
    "prototype:build": "node scripts/prototype.ts",
    "dev": "wrangler dev",
    "build": "npm run site:build",
    "site:build": "node scripts/site.ts",
    "site:deploy": "wrangler deploy",
    "check": "tsc",
    "check:dependencies": "npm audit --audit-level=moderate",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "verify": "npm run format:check && npm run lint && npm run check && npm test",
    "deps:sync": "node scripts/deps-sync.ts",
    "node:update": "node scripts/node-update.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.156.2"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
